/** this is a rule generated from an user configuration **/
package com.adeo.lmru_testing;

import java.lang.Number;
import java.math.BigDecimal;
import java.math.RoundingMode;
import java.time.LocalDateTime;

rule "LP_PROFI_DISCOUNT"
    dialect "mvel"
    ruleflow-group "reductionligne"
    salience "9901"
    when
            (com.adeo.lys.model.v2.ActiveTypology(name=="punctual") or not com.adeo.lys.model.v2.ActiveTypology())
            context : com.adeo.lys.model.v2.Context(dateTime >= LocalDateTime.parse("1970-12-30T21:00") , dateTime <= LocalDateTime.parse("2999-12-30T23:59:59") , usePointsAsDiscount == true)
            availableCounterToPPP : com.adeo.lys.model.v2.Counter(code == "P" , availableforEarn > 0)
            			 tot : BigDecimal(intValue >= 1) from accumulate (
			com.adeo.lys.model.v2.Line( n : number,qua : quantity, ua : unitaryAmount,smlist : segmentMatches, excludedDiscountCategories not contains "punctual")
			&& com.adeo.lys.model.v2.SegmentMatch(smlist contains this ,code=="4001",type=="LIST"),
				init( BigDecimal result = new BigDecimal(0.0); ),
				action( result = result.add(qua.multiply(ua)); ),
				reverse( result = result.min(qua.multiply(ua)); ),
				result( result )
		)

		 totqua : BigDecimal(intValue >= 0) from accumulate (
			com.adeo.lys.model.v2.Line( n : number,qua : quantity, ua : unitaryAmount,smlist : segmentMatches, excludedDiscountCategories not contains "punctual")
			&& com.adeo.lys.model.v2.SegmentMatch(smlist contains this ,code=="4001",type=="LIST"),
				init( BigDecimal result = new BigDecimal(0.0); ),
				action( result = result.add(qua); ),
				reverse( result = result.min(qua); ),
				result( result )
		)

            com.adeo.lys.model.v2.Context(java.util.Arrays.asList("908","906","352","252","181","174","169","165","163","156","155","153","150","147","143","142","141","140","139","138","137","136","135","134","131","129","128","127","126","125","124","123","122","119","118","117","115","114","111","110","109","94","93","92","91","90","89","88","87","86","83","82","81","80","79","78","77","75","74","73","71","70","69","68","67","65","62","59","58","57","56","55","53","52","51","49","48","47","46","44","43","42","41","40","39","38","37","36","35","34","33","32","31","30","28","27","26","25","24","23","22","21","20","19","18","17","16","14","13","12","11","10","9","8","7","6","5","4","3","2","0","411") contains entityId)
            com.adeo.lys.model.v2.BasketSubTotal(subtotalAmount >= "0" , key == "totalTicket")
            com.adeo.lys.model.v2.Loyalty(java.util.Arrays.asList("VALID") contains status)
            com.adeo.lys.model.v2.BasketSubTotal(subtotalAmount > "0" , key == "totalTicket")
            com.adeo.lys.model.v2.Loyalty(java.util.Arrays.asList("3") contains type)
            			tlbts : java.util.ArrayList( size>0) from accumulate (
			    ll : com.adeo.lys.model.v2.TotalLineReductionByTypology(typology == "punctual"),
			    collectList(ll))

            concernedLines : java.util.ArrayList( size>0) from accumulate (
				oo : com.adeo.lys.model.v2.Line(excludedDiscountCategories not contains "punctual", smlist1 : segmentMatches, nn : number, type : type,  java.util.Arrays.asList("2P","3P") not contains offerType)
				&& ol : com.adeo.lys.model.v2.TotalLineReduction(number == nn , totalDiscount : amount)
				&& com.adeo.lys.model.v2.ReductionLineType( lineType == type, code == "punctual")
				&& not com.adeo.lys.model.v2.LineReduction( number==nn,key=="LP_PROFI_DISCOUNT")
				&& not com.adeo.lys.model.v2.RemovedReduction( lineNumber==nn,lineReduction.key=="LP_PROFI_DISCOUNT")
				&& com.adeo.lys.model.v2.SegmentMatch(smlist1 contains this ,code=="4001",type=="LIST"),
			collectList(new com.adeo.lys.model.v2.CompleteLine(oo,ol)))
        then
            BigDecimal pointAmountValue = BigDecimal.valueOf(availableCounterToPPP.getAvailableforEarn());
BigDecimal discountAmount = tot.multiply(BigDecimal.valueOf(99)).divide(100, 2, RoundingMode.DOWN)
    .min(pointAmountValue.setScale(2, RoundingMode.DOWN));

BigDecimal realDiscountAmount = BigDecimal.ZERO;
java.util.ArrayList facts = new java.util.ArrayList();

for (Object  o : concernedLines) {
    com.adeo.lys.model.v2.CompleteLine completeLine = (com.adeo.lys.model.v2.CompleteLine) o;
    com.adeo.lys.model.v2.Line line = completeLine.getLine();
    com.adeo.lys.model.v2.TotalLineReduction totalReduction = completeLine.getTotalLineReduction();
    BigDecimal totalLineReduction = totalReduction.getAmount();
    for (com.adeo.lys.model.v2.TotalLineReductionByTypology tlbt : tlbts) {
        if (tlbt.getNumber().equals(line.getNumber())) {
            totalLineReduction = totalLineReduction.subtract(tlbt.getAmount());
        }
    }

    BigDecimal result = discountAmount.multiply(line.getQuantity().multiply(line.getUnitaryAmount()))
        .subtract(totalLineReduction)
        .divide(tot, 0, RoundingMode.DOWN);
    result = result.min(line.getQuantity().multiply(line.getUnitaryAmount()).subtract(totalLineReduction).setScale(0, RoundingMode.DOWN));

    realDiscountAmount = realDiscountAmount.add(result);

    com.adeo.lys.model.v2.LineReduction fact0 = new com.adeo.lys.model.v2.LineReduction();
    fact0.setNumber(line.getNumber());
    fact0.setAmount(result);
    fact0.setMultiline(true);
    fact0.setKey("LP_PROFI_DISCOUNT");
    fact0.setDescription("Loyalty Program PROFI Points as Discount");
    fact0.setTypology("punctual");
    fact0.setUnit("FIXED");
    fact0.setCalcModeCode("FIXED");
    fact0.setOfferCode("LP_PROFI_POINTS_AS_DISCOUNT");
    fact0.setRewardType("DISCOUNT");
    fact0.setAdvantageCode("LP_PROFI_DISCOUNT");
    fact0.setAdvantageId("4071");
    fact0.setTemplateCode("punctual");
    fact0.setExternalCode("4");
    fact0.setBenefType("PRODUCT_LIST");
    fact0.setImpact("ON_TRANSACTION");
    fact0.setShortLabel("Loyalty Program PROFI Points as Discount");
    fact0.setLimited(false);
    facts.add(fact0);

    com.adeo.lys.model.v2.LineReduction fact0bis = new com.adeo.lys.model.v2.LineReduction();
    fact0bis.setNumber(line.getNumber());
    fact0bis.setAdvantageCode("LP_PROFI_DISCOUNT");
    fact0bis.setMultiline(true);
    fact0bis.setAmount(result);
    fact0bis.setUnit("POINT");
    fact0bis.setTemplateCode("punctual");
    fact0bis.setOperation("BURN");
    fact0bis.setKey("LP_PROFI_DISCOUNT");
    fact0bis.setDescription("Loyalty Program PROFI Points as Discount");
    fact0bis.setTypology("punctual");
    fact0bis.setOfferCode("LP_PROFI_POINTS_AS_DISCOUNT");
    fact0bis.setRewardType("UNIT_LOST");
    fact0bis.setAdvantageId("4071");
    fact0bis.setExternalCode("4");
    fact0bis.setImpact("ON_TRANSACTION");
    fact0bis.setShortLabel("Loyalty Program PROFI Points as Discount");
    fact0bis.setLimited(false);
    facts.add(fact0bis);
}

for (Object o : facts) {
    com.adeo.lys.model.v2.LineReduction f = (com.adeo.lys.model.v2.LineReduction) o;
    f.setValue(realDiscountAmount);

    insert(f);
}
    end
