package com.adeo.lmru_testing;


rule "ParameterReductionLigne_1"
	ruleflow-group "validationinput"
	dialect "mvel"
	when
	then
		com.adeo.lys.model.v2.ReductionParameter ii = new com.adeo.lys.model.v2.ReductionParameter();
		ii.setCode( "punctual" );
		ii.setPriority( 10 );
		ii.setAsMany( false );
		insert( ii );
		com.adeo.lys.model.v2.ReductionCompatible fact1 = new com.adeo.lys.model.v2.ReductionCompatible();
		fact1.setCode( "punctual" );
		fact1.setCodeCompatible( "punctual" );
		insertLogical( fact1 );
		com.adeo.lys.model.v2.ReductionCompatible fact2 = new com.adeo.lys.model.v2.ReductionCompatible();
		fact2.setCode( "punctual" );
		fact2.setCodeCompatible( "rank" );
		insertLogical( fact2 );
		com.adeo.lys.model.v2.ReductionCompatible fact3 = new com.adeo.lys.model.v2.ReductionCompatible();
		fact3.setCode( "punctual" );
		fact3.setCodeCompatible( "points" );
		insertLogical( fact3 );
		com.adeo.lys.model.v2.ReductionLineType fact4 = new com.adeo.lys.model.v2.ReductionLineType();
		fact4.setCode( "punctual" );
		fact4.setLineType( "SALE" );
		insertLogical( fact4 );
		com.adeo.lys.model.v2.ReductionLineType fact5 = new com.adeo.lys.model.v2.ReductionLineType();
		fact5.setCode( "punctual" );
		fact5.setLineType( "ORDER_TAKE_AWAY" );
		insertLogical( fact5 );
		com.adeo.lys.model.v2.ReductionLineType fact6 = new com.adeo.lys.model.v2.ReductionLineType();
		fact6.setCode( "punctual" );
		fact6.setLineType( "ORDER_VALIDATION" );
		insertLogical( fact6 );	end

