/** this is a generic rules for all BU, not generated from an user configuration **/
package com.adeo.lmru_testing;

import java.math.RoundingMode;
import java.lang.Number;
import java.math.BigDecimal;
import java.time.LocalDateTime;
import java.math.RoundingMode;


rule "APPLY_DISCOUNT_IN_PURCHASE_OVER_HUNDREDCTM_TRN_PERCENT"
	dialect "mvel"
	ruleflow-group "reductionligne"
    salience "7400"
when
		(com.adeo.lys.model.v2.ActiveTypology(name=="purchase_over_hundredctm") or not com.adeo.lys.model.v2.ActiveTypology())
		bst : com.adeo.lys.model.v2.BasketSubTotal( key == "sousTotalBase" , tot : subtotalAmount != null )
		di : com.adeo.lys.model.v2.DiscountIn( ccode : code != null , unit == "PERCENT" , vv : value != null, typology=="purchase_over_hundredctm", rewardIdToBurn == null, fromOrderContext == false)
		ba : com.adeo.lys.model.v2.Basket( discounts contains di , lines : lines)
        not (com.adeo.lys.model.v2.BasketReduction(key == di.code) )
	then
        com.adeo.lys.model.v2.BasketReduction fact0 = new com.adeo.lys.model.v2.BasketReduction();
        fact0.setExternalCode(di.getExternalCode());
        fact0.setAmount(di.getValue());
        fact0.setKey(di.getCode());
        fact0.setDescription(di.getCode());
        fact0.setTypology(di.getTypology());
        fact0.setUnit("PERCENT");
        fact0.setCalcModeCode("PERCENT");
        fact0.setRewardType("DISCOUNT");
        fact0.setAdvantageCode(di.getCode());
        fact0.setTemplateCode(di.getTypology());
        fact0.setBenefType("TRANSACTION");
        fact0.setImpact(di.getImpact());
        insert( fact0 );
end
