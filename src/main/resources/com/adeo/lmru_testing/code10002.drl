/** this is a rule generated from an user configuration **/
package com.adeo.lmru_testing;

import java.lang.Number;
import java.math.BigDecimal;
import java.math.RoundingMode;
import java.time.LocalDateTime;

rule "code10002"
    dialect "mvel"
    ruleflow-group "reductionligne"
    salience "7001"
    when
            (com.adeo.lys.model.v2.ActiveTypology(name=="points") or not com.adeo.lys.model.v2.ActiveTypology())
            context : com.adeo.lys.model.v2.Context(dateTime >= LocalDateTime.parse("1970-12-30T21:00") , dateTime <= LocalDateTime.parse("2999-12-30T23:59:59"))
            oo : com.adeo.lys.model.v2.Line(nn : number , type : type , excludedDiscountCategories not contains "points" , java.util.Arrays.asList("2P","3P") not contains offerType , productId == "10002236" , discountable == true)
            com.adeo.lys.model.v2.ReductionLineType(code == "points" , lineType == type)
            not (com.adeo.lys.model.v2.LineReduction(number == nn , key == "code10002") )
            not (com.adeo.lys.model.v2.RemovedReduction(lineNumber == nn , lineReduction.key == "code10002") )
            com.adeo.lys.model.v2.Loyalty(java.util.Arrays.asList("VALID") contains status)
            com.adeo.lys.model.v2.Loyalty(java.util.Arrays.asList("3") contains type)
            com.adeo.lys.model.v2.TotalLineReduction(number == nn , totalDiscount : amount)
            			tlbts : java.util.ArrayList( size>0) from accumulate (
			    ll : com.adeo.lys.model.v2.TotalLineReductionByTypology(typology == "points"),
			    collectList(ll))

        then
            com.adeo.lys.model.v2.LineReduction fact0 = new com.adeo.lys.model.v2.LineReduction();
            			BigDecimal totalLigneReduction = totalDiscount;
			for (com.adeo.lys.model.v2.TotalLineReductionByTypology tlbt : tlbts){
			    if (tlbt.getNumber().equals(oo.getNumber())){
			        totalLigneReduction = totalLigneReduction.subtract(tlbt.getAmount());
			    }
			}

            BigDecimal each = BigDecimal.valueOf(1);
            BigDecimal eachAmount = BigDecimal.valueOf(1).multiply(each).multiply(oo.getUnitaryAmount());
            fact0.setValue(1);
            fact0.setNumber(nn);
            fact0.setAmount(eachAmount.subtract(totalLigneReduction).multiply(BigDecimal.valueOf(1)).divide(BigDecimal.valueOf(100), 2, RoundingMode.HALF_UP));
            fact0.setMultiLineAmount(eachAmount.subtract(totalLigneReduction).multiply(BigDecimal.valueOf(1)).divide(BigDecimal.valueOf(100), 2, RoundingMode.HALF_UP));
            fact0.setKey("code10002");
            fact0.setDescription("code10002");
            fact0.setTypology("points");
            fact0.setUnit("PERCENT");
            fact0.setCalcModeCode("PERCENT");
            fact0.setOfferCode("LP_PROFI_POINTS_MANAGEMENT");
            fact0.setRewardType("DISCOUNT");
            fact0.setAdvantageCode("code10002");
            fact0.setAdvantageId("105");
            fact0.setTemplateCode("points");
            fact0.setExternalCode("11");
            fact0.setBenefType("PRODUCT");
            fact0.setImpact("ON_TRANSACTION");
            fact0.setShortLabel("code10002");
            fact0.setLimited(false);
            if (fact0.getAmount()>0){
			insert( fact0 );
}
    end
