/** this is a rule generated from an user configuration **/
package com.adeo.lmru;

import java.lang.Number;
import java.math.BigDecimal;
import java.math.RoundingMode;
import java.time.LocalDateTime;

rule "testddd"
    dialect "mvel"
    ruleflow-group "reductionligne"
    salience "7001"
    when
            (com.adeo.lys.model.v2.ActiveTypology(name=="points") or not com.adeo.lys.model.v2.ActiveTypology())
            context : com.adeo.lys.model.v2.Context(dateTime >= LocalDateTime.parse("2026-03-04T22:00") , dateTime <= LocalDateTime.parse("2026-03-06T23:59:59") , channel == "WEB")
            			 tot : BigDecimal(intValue >= 0) from accumulate (
			com.adeo.lys.model.v2.Line( n : number,qua : quantity, ua : unitaryAmount,smlist : segmentMatches, excludedDiscountCategories not contains "points")
			&& com.adeo.lys.model.v2.SegmentMatch(smlist contains this ,code=="91",type=="LIST"),
				init( BigDecimal result = new BigDecimal(0.0); ),
				action( result = result.add(qua.multiply(ua)); ),
				reverse( result = result.min(qua.multiply(ua)); ),
				result( result )
		)

		 totqua : BigDecimal(intValue >= 55) from accumulate (
			com.adeo.lys.model.v2.Line( n : number,qua : quantity, ua : unitaryAmount,smlist : segmentMatches, excludedDiscountCategories not contains "points")
			&& com.adeo.lys.model.v2.SegmentMatch(smlist contains this ,code=="91",type=="LIST"),
				init( BigDecimal result = new BigDecimal(0.0); ),
				action( result = result.add(qua); ),
				reverse( result = result.min(qua); ),
				result( result )
		)

            not (com.adeo.lys.model.v2.LineReduction(key == "testddd") )
            not (com.adeo.lys.model.v2.RemovedReduction(lineReduction.key == "testddd") )
            com.adeo.lys.model.v2.Context(java.util.Arrays.asList("7","4","3","2","5") contains entityId)
            			BigDecimal(intValue >= 0) from accumulate (
			com.adeo.lys.model.v2.Line( n : number,qua : quantity, ua : unitaryAmount,smlist : segmentMatches)
			&& com.adeo.lys.model.v2.SegmentMatch(smlist contains this ,code=="92",type=="LIST"),
				init( BigDecimal result = new BigDecimal(0.0); ),
				action( result = result.add(qua.multiply(ua)); ),
				reverse( result = result.min(qua.multiply(ua)); ),
				result( result )
		)

		BigDecimal(intValue >= 500) from accumulate (
			com.adeo.lys.model.v2.Line( n : number,qua : quantity, ua : unitaryAmount,smlist : segmentMatches)
			&& com.adeo.lys.model.v2.SegmentMatch(smlist contains this ,code=="92",type=="LIST"),
				init( BigDecimal result = new BigDecimal(0.0); ),
				action( result = result.add(qua); ),
				reverse( result = result.min(qua); ),
				result( result )
		)

            not (com.adeo.lys.model.v2.LineReduction(key == "testddd") )
            not (com.adeo.lys.model.v2.RemovedReduction(lineReduction.key == "testddd") )
            			tlbts : java.util.ArrayList( size>0) from accumulate (
			    ll : com.adeo.lys.model.v2.TotalLineReductionByTypology(typology == "points"),
			    collectList(ll))

            concernedLines : java.util.ArrayList( size>0) from accumulate (
				oo : com.adeo.lys.model.v2.Line(excludedDiscountCategories not contains "points", smlist1 : segmentMatches, nn : number, type : type,  java.util.Arrays.asList("2P","3P") not contains offerType)
				&& ol : com.adeo.lys.model.v2.TotalLineReduction(number == nn , totalDiscount : amount)
				&& com.adeo.lys.model.v2.ReductionLineType( lineType == type, code == "points")
				&& not com.adeo.lys.model.v2.LineReduction( number==nn,key=="testddd")
				&& not com.adeo.lys.model.v2.RemovedReduction( lineNumber==nn,lineReduction.key=="testddd")
				&& com.adeo.lys.model.v2.SegmentMatch(smlist1 contains this ,code=="91",type=="LIST"),
			collectList(new com.adeo.lys.model.v2.CompleteLine(oo,ol)))
        then
            com.adeo.lys.model.v2.LineReduction fact0 = new com.adeo.lys.model.v2.LineReduction();
            com.adeo.lys.model.v2.CompleteLine completeLine = com.adeo.lys.model.v2.CompleteLine.getMaxPriceCompleteLine(concernedLines);
            com.adeo.lys.model.v2.Line line = completeLine.getLine();
            com.adeo.lys.model.v2.TotalLineReduction totalReduction = completeLine.getTotalLineReduction();
            fact0.setMultiLineAmount(5);
            fact0.setValue(5);
            fact0.setNumber(line.getNumber());
            fact0.setAmount(line.getUnitaryAmount().subtract(totalReduction.getAmount()).multiply(BigDecimal.valueOf(5)).divide(BigDecimal.valueOf(100), 2, RoundingMode.HALF_UP));
            fact0.setKey("testddd");
            fact0.setDescription("testdd");
            fact0.setTypology("points");
            fact0.setUnit("PERCENT");
            fact0.setCalcModeCode("PERCENT");
            fact0.setOfferCode("DASD");
            fact0.setRewardType("DISCOUNT");
            fact0.setAdvantageCode("testddd");
            fact0.setAdvantageId("155");
            fact0.setTemplateCode("points");
            fact0.setExternalCode("5");
            fact0.setBenefType("PRODUCT_LIST");
            fact0.setImpact("ON_TRANSACTION");
            fact0.setShortLabel("testdd");
            fact0.setLimited(false);
            if (fact0.getAmount()>0){
			insert( fact0 );
}
    end
