package com.adeo.lmru_testing;

import java.lang.Number;
import java.math.BigDecimal;
import java.math.RoundingMode;
import java.time.LocalDateTime;

rule "PROMO51007"
    dialect "mvel"
    ruleflow-group "reductionligne"
    salience "9701"
    when
            (com.adeo.lys.model.v2.ActiveTypology(name=="common_promocodes") or not com.adeo.lys.model.v2.ActiveTypology())
            context : com.adeo.lys.model.v2.Context(dateTime >= LocalDateTime.parse("2025-10-01T00:00") , dateTime <= LocalDateTime.parse("2025-10-31T23:59:59"))
            not (com.adeo.lys.model.v2.AdvantageHistory(advantageId == 281 , triggeredCount >= 1) )
            not (com.adeo.lys.model.v2.AdvantageHistory(activationCode == "PROMO51007" , totalTriggeredCount >= 2500) )
            com.adeo.lys.model.v2.BasketSubTotal(subtotalAmount > "1" , key == "totalTicket")
            com.adeo.lys.model.v2.SegmentMatch(type == "POS" , code == "250")
            			 tot : BigDecimal(intValue <= 300000) from accumulate (
			com.adeo.lys.model.v2.Line( n : number,qua : quantity, ua : unitaryAmount,smlist : segmentMatches, excludedDiscountCategories not contains "common_promocodes")
			&& com.adeo.lys.model.v2.SegmentMatch(smlist contains this ,code=="119",type=="LIST"),
				init( BigDecimal result = new BigDecimal(0.0); ),
				action( result = result.add(qua.multiply(ua)); ),
				reverse( result = result.min(qua.multiply(ua)); ),
				result( result )
		)

		 totqua : BigDecimal(intValue >= 0) from accumulate (
			com.adeo.lys.model.v2.Line( n : number,qua : quantity, ua : unitaryAmount,smlist : segmentMatches, excludedDiscountCategories not contains "common_promocodes")
			&& com.adeo.lys.model.v2.SegmentMatch(smlist contains this ,code=="119",type=="LIST"),
				init( BigDecimal result = new BigDecimal(0.0); ),
				action( result = result.add(qua); ),
				reverse( result = result.min(qua); ),
				result( result )
		)

            com.adeo.lys.model.v2.ActivationCode(value == "PROMO51007")
            			tlbts : java.util.ArrayList( size>0) from accumulate (
			    ll : com.adeo.lys.model.v2.TotalLineReductionByTypology(typology == "common_promocodes"),
			    collectList(ll))

            concernedLines : java.util.ArrayList( size>0) from accumulate (
				oo : com.adeo.lys.model.v2.Line(excludedDiscountCategories not contains "common_promocodes", smlist1 : segmentMatches, nn : number, type : type,  java.util.Arrays.asList("2P","3P") not contains offerType)
				&& ol : com.adeo.lys.model.v2.TotalLineReduction(number == nn , totalDiscount : amount)
				&& com.adeo.lys.model.v2.ReductionLineType( lineType == type, code == "common_promocodes")
				&& not com.adeo.lys.model.v2.LineReduction( number==nn,key=="PROMO51007")
				&& not com.adeo.lys.model.v2.RemovedReduction( lineNumber==nn,lineReduction.key=="PROMO51007")
				&& com.adeo.lys.model.v2.SegmentMatch(smlist1 contains this ,code=="119",type=="LIST"),
			collectList(new com.adeo.lys.model.v2.CompleteLine(oo,ol)))
        then
            			BigDecimal each = BigDecimal.valueOf(1);
			for (Object  o : concernedLines){
			com.adeo.lys.model.v2.CompleteLine completeLine=(com.adeo.lys.model.v2.CompleteLine)o;
			com.adeo.lys.model.v2.Line line = completeLine.getLine();
			com.adeo.lys.model.v2.TotalLineReduction totalReduction = completeLine.getTotalLineReduction();
			BigDecimal totalLineReduction = totalReduction.getAmount();
			for (com.adeo.lys.model.v2.TotalLineReductionByTypology tlbt : tlbts){
			    if (tlbt.getNumber().equals(line.getNumber())){
			        totalLineReduction = totalLineReduction.subtract(tlbt.getAmount());
			    }
			}
			com.adeo.lys.model.v2.LineReduction fact0 = new com.adeo.lys.model.v2.LineReduction();
			fact0.setNumber(line.getNumber());
			fact0.setValue(BigDecimal.valueOf(5));
			BigDecimal result = null; 
			result = line.getQuantity().multiply(line.getUnitaryAmount()).subtract(totalLineReduction).multiply(BigDecimal.valueOf(5).divide(100)).setScale(0, RoundingMode.DOWN);
			result = result.min(line.getQuantity().multiply(line.getUnitaryAmount()).subtract(totalLineReduction)).setScale(0, RoundingMode.DOWN);
			fact0.setAmount(result);
			fact0.setMultiline(true);
			fact0.setKey("PROMO51007"); 
			fact0.setDescription("PROMO51007"); 
			fact0.setTypology("common_promocodes"); 
			fact0.setUnit("PERCENT"); 
			fact0.setCalcModeCode("PERCENT"); 
			fact0.setOfferCode("PROMO51007"); 
			fact0.setRewardType("DISCOUNT"); 
			fact0.setAdvantageCode("PROMO51007"); 
			fact0.setAdvantageId("281"); 
			fact0.setTemplateCode("common_promocodes"); 
			fact0.setExternalCode("19"); 
			fact0.setBenefType("PRODUCT_LIST"); 
			fact0.setImpact("ON_TRANSACTION"); 
			fact0.setShortLabel("PROMO51007"); 
			fact0.setLimited(true); 
			fact0.setTotalLimited(true); 
			fact0.setTriggeredPromoCode("PROMO51007"); 
		    insert( fact0 );
		}
    end
