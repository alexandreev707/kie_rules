/** this is a generic rules for all BU, not generated from an user configuration **/
package com.adeo.lmru_testing;

import java.math.RoundingMode;
import java.lang.Number;
import java.math.BigDecimal;
import java.time.LocalDateTime;
import java.math.RoundingMode;


rule "APPLY_DISCOUNT_IN_POINTS_PROMO_LINE_FIXED"
	dialect "mvel"
	ruleflow-group "reductionligne"
    salience "5001"
	when
		(com.adeo.lys.model.v2.ActiveTypology(name=="points_promo") or not com.adeo.lys.model.v2.ActiveTypology())
		di : com.adeo.lys.model.v2.DiscountIn( ccode : code != null , unit == "FIXED" , vv : value != null, typology=="points_promo", rewardIdToBurn == null, fromOrderContext == false)
		ba : com.adeo.lys.model.v2.Basket()
	    oo : com.adeo.lys.model.v2.Line(discounts contains di ,nn : number,qua1 : quantity, ua1 : unitaryAmount, type : type)
	    com.adeo.lys.model.v2.ReductionLineType(code == "points_promo", lineType == type)
        not (com.adeo.lys.model.v2.LineReduction( number==nn,key==di.getCode()))
        not (com.adeo.lys.model.v2.RemovedReduction( lineNumber==nn,lineReduction.key==di.getCode()))
        com.adeo.lys.model.v2.TotalLineReduction(number==nn,totalDiscount : amount)
	then
        com.adeo.lys.model.v2.LineReduction fact0 = new com.adeo.lys.model.v2.LineReduction();
        fact0.setExternalCode(di.getExternalCode());
        fact0.setNumber(oo.getNumber());
        fact0.setValue(vv);
        BigDecimal result= vv.min(qua1.multiply(ua1).subtract(totalDiscount));
        fact0.setAmount(result);
        fact0.setMultiline(false);
        fact0.setUnit(di.getUnit());
        fact0.setKey(di.getCode());
        fact0.setTypology(di.getTypology());
        fact0.setUnit(di.getUnit());
        fact0.setCalcModeCode(di.getUnit());
        fact0.setOfferCode(di.getCode());
        fact0.setRewardType("DISCOUNT");
        fact0.setTemplateCode(di.getTypology());
        fact0.setBenefType("PRODUCT");
        fact0.setImpact(di.getImpact());
        insert( fact0 );
end
