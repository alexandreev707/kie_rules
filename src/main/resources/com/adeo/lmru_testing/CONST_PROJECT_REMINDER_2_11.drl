/** this is a rule generated from an user configuration **/
package com.adeo.lmru_testing;

import java.lang.Number;
import java.math.BigDecimal;
import java.math.RoundingMode;
import java.time.LocalDateTime;

rule "CONST_PROJECT_REMINDER_2_11"
    dialect "mvel"
    ruleflow-group "reductionligne"
    salience "9651"
    when
            (com.adeo.lys.model.v2.ActiveTypology(name=="unique_promocodes") or not com.adeo.lys.model.v2.ActiveTypology())
            context : com.adeo.lys.model.v2.Context(dateTime >= LocalDateTime.parse("2025-11-04T00:00") , dateTime <= LocalDateTime.parse("2025-12-04T23:59:59"))
            not (com.adeo.lys.model.v2.AdvantageHistory(advantageId == 350 , triggeredCount >= 2) )
            			 tot : BigDecimal(intValue >= 300001) from accumulate (
			com.adeo.lys.model.v2.Line( n : number,qua : quantity, ua : unitaryAmount,smlist : segmentMatches, excludedDiscountCategories not contains "unique_promocodes")
			&& com.adeo.lys.model.v2.SegmentMatch(smlist contains this ,code=="153",type=="LIST"),
				init( BigDecimal result = new BigDecimal(0.0); ),
				action( result = result.add(qua.multiply(ua)); ),
				reverse( result = result.min(qua.multiply(ua)); ),
				result( result )
		)

		 totqua : BigDecimal(intValue >= 0) from accumulate (
			com.adeo.lys.model.v2.Line( n : number,qua : quantity, ua : unitaryAmount,smlist : segmentMatches, excludedDiscountCategories not contains "unique_promocodes")
			&& com.adeo.lys.model.v2.SegmentMatch(smlist contains this ,code=="153",type=="LIST"),
				init( BigDecimal result = new BigDecimal(0.0); ),
				action( result = result.add(qua); ),
				reverse( result = result.min(qua); ),
				result( result )
		)

            com.adeo.lys.model.v2.SegmentMatch(type == "POS" , code == "250")
            com.adeo.lys.model.v2.ActivationCode(value == "CONSTRUCTION_PROJECT_REMINDER")
            			tlbts : java.util.ArrayList( size>0) from accumulate (
			    ll : com.adeo.lys.model.v2.TotalLineReductionByTypology(typology == "unique_promocodes"),
			    collectList(ll))

            concernedLines : java.util.ArrayList( size>0) from accumulate (
				oo : com.adeo.lys.model.v2.Line(excludedDiscountCategories not contains "unique_promocodes", smlist1 : segmentMatches, nn : number, type : type,  java.util.Arrays.asList("2P","3P") not contains offerType)
				&& ol : com.adeo.lys.model.v2.TotalLineReduction(number == nn , totalDiscount : amount)
				&& com.adeo.lys.model.v2.ReductionLineType( lineType == type, code == "unique_promocodes")
				&& not com.adeo.lys.model.v2.LineReduction( number==nn,key=="CONST_PROJECT_REMINDER_2_11")
				&& not com.adeo.lys.model.v2.RemovedReduction( lineNumber==nn,lineReduction.key=="CONST_PROJECT_REMINDER_2_11")
				&& com.adeo.lys.model.v2.SegmentMatch(smlist1 contains this ,code=="153",type=="LIST"),
			collectList(new com.adeo.lys.model.v2.CompleteLine(oo,ol)))
        then
            			BigDecimal each = BigDecimal.valueOf(1);
			for (Object  o : concernedLines){
			com.adeo.lys.model.v2.CompleteLine completeLine=(com.adeo.lys.model.v2.CompleteLine)o;
			com.adeo.lys.model.v2.Line line = completeLine.getLine();
			com.adeo.lys.model.v2.TotalLineReduction totalReduction = completeLine.getTotalLineReduction();
			BigDecimal totalLineReduction = totalReduction.getAmount();
			for (com.adeo.lys.model.v2.TotalLineReductionByTypology tlbt : tlbts){
			    if (tlbt.getNumber().equals(line.getNumber())){
			        totalLineReduction = totalLineReduction.subtract(tlbt.getAmount());
			    }
			}
			com.adeo.lys.model.v2.LineReduction fact0 = new com.adeo.lys.model.v2.LineReduction();
			fact0.setNumber(line.getNumber());
			fact0.setValue(BigDecimal.valueOf(30000));
			BigDecimal result = null; 
			result = BigDecimal.valueOf(30000).multiply(each).multiply(line.getQuantity().multiply(line.getUnitaryAmount())).subtract(totalLineReduction).divide(tot, 0, RoundingMode.DOWN);
			result = result.min(line.getQuantity().multiply(line.getUnitaryAmount()).subtract(totalLineReduction)).setScale(0, RoundingMode.DOWN);
			fact0.setAmount(result);
			fact0.setMultiline(true);
			fact0.setKey("CONST_PROJECT_REMINDER_2_11"); 
			fact0.setDescription("CONST_PROJECT_REMINDER_2_11"); 
			fact0.setTypology("unique_promocodes"); 
			fact0.setUnit("FIXED"); 
			fact0.setCalcModeCode("FIXED"); 
			fact0.setOfferCode("REMINDER_CONSTRUCTION_PROJE"); 
			fact0.setRewardType("DISCOUNT"); 
			fact0.setAdvantageCode("CONST_PROJECT_REMINDER_2_11"); 
			fact0.setAdvantageId("350"); 
			fact0.setTemplateCode("unique_promocodes"); 
			fact0.setExternalCode("19"); 
			fact0.setBenefType("PRODUCT_LIST"); 
			fact0.setImpact("ON_TRANSACTION"); 
			fact0.setShortLabel("CONST_PROJECT_REMINDER_2_11"); 
			fact0.setLimited(true); 
			fact0.setTriggeredPromoCode("CONSTRUCTION_PROJECT_REMINDER"); 
		    insert( fact0 );
		}
    end
