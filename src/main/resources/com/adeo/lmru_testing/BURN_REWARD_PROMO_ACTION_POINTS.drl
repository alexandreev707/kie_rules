/** this is a generic rules for all BU, not generated from an user configuration **/
package com.adeo.lmru_testing;

import java.math.RoundingMode;
import java.lang.Number;
import java.math.BigDecimal;
import java.time.LocalDateTime;
import java.math.RoundingMode;

rule "BURN_REWARD_PROMO_ACTION_POINTS"
	dialect "mvel"
	ruleflow-group "reductionligne"
    salience "7950"
	when
		(com.adeo.lys.model.v2.ActiveTypology(name=="promo_action_points") or not com.adeo.lys.model.v2.ActiveTypology())
		bst : com.adeo.lys.model.v2.BasketSubTotal( key == "sousTotalBase" , tot : subtotalAmount != null )
		di : com.adeo.lys.model.v2.DiscountIn( ccode : code != null , engineTemplateCode == "promo_action_points" , vv : value != null,  rewardIdToBurn != null, fromOrderContext == false)
		ba : com.adeo.lys.model.v2.Basket( discounts contains di , lines : lines)
	    oo : com.adeo.lys.model.v2.Line(nn : number,qua1 : quantity, ua1 : unitaryAmount)
        not (com.adeo.lys.model.v2.LineReduction(key==di.getCode(), locked == false))
        not (com.adeo.lys.model.v2.RemovedReduction(key==di.getCode()))
        com.adeo.lys.model.v2.Loyalty(status=="VALID")
	then
        com.adeo.lys.model.v2.BasketReduction fact0 = new com.adeo.lys.model.v2.BasketReduction();
        fact0.setExternalCode(di.getExternalCode());
        fact0.setAmount(vv);
        fact0.setKey(di.getCode());
        fact0.setDescription(di.getLabel());
        fact0.setShortLabel(di.getLabel());
        fact0.setTypology("promo_action_points");
        fact0.setUnit(di.getUnit());
        fact0.setCalcModeCode(di.getUnit());
        fact0.setOfferCode("Burn Reward");
        fact0.setRewardType("DISCOUNT");
        fact0.setAdvantageCode("Burn Reward");
        fact0.setTemplateCode("promo_action_points");
        fact0.setExternalRewardToBurn(di.getRewardIdToBurn());
        fact0.setRewardId(di.getRewardIdToBurn());
        fact0.setBenefType("TRANSACTION");
        fact0.setImpact("ON_TRANSACTION");
        insert( fact0 );
end
