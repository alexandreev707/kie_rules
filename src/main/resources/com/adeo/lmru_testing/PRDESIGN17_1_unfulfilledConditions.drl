                            com.adeo.lys.model.v2.UnfulfilledCondition unfulfilledCondition0 = new com.adeo.lys.model.v2.UnfulfilledCondition();
                unfulfilledCondition0.setErrorCode(46);
                $cc.getUnfulfilledConditions().add(unfulfilledCondition0);
