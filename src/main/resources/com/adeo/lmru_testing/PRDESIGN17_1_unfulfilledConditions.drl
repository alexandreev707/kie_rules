                            com.adeo.lys.model.v2.UnfulfilledCondition unfulfilledCondition2 = new com.adeo.lys.model.v2.UnfulfilledCondition();
                unfulfilledCondition2.setErrorCode(41);
                $cc.getUnfulfilledConditions().add(unfulfilledCondition2);
                return;
             }
            if ($cc.getUnfulfilledConditions().isEmpty()) {
                            com.adeo.lys.model.v2.UnfulfilledCondition unfulfilledCondition3 = new com.adeo.lys.model.v2.UnfulfilledCondition();
                unfulfilledCondition3.setErrorCode(1);
                $cc.getUnfulfilledConditions().add(unfulfilledCondition3);
                return;
             }
    end
